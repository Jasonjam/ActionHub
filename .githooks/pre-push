#!/bin/sh

echo ""
echo "========== PUSH 前處理 =========="

echo ""
echo "========== Build BAT 格式檢查 =========="

BAT_FILE="build.bat"
BAT_TEMP="$(mktemp)"
export BAT_TEMP_WIN="$(cygpath -w "$BAT_TEMP")"

# 讀取目前 Commit 中的 build.bat
if ! git show "HEAD:$BAT_FILE" > "$BAT_TEMP"; then
    echo "[錯誤] 無法讀取 Commit 中的 $BAT_FILE"
    rm -f "$BAT_TEMP"
    exit 1
fi

# 檢查 UTF-8 無 BOM 與 CRLF
if ! powershell.exe -NoProfile -Command '
    $ErrorActionPreference = "Stop"
    $path = $env:BAT_TEMP_WIN
    $data = [System.IO.File]::ReadAllBytes($path)

    try {
        $utf8 = New-Object System.Text.UTF8Encoding($false, $true)
        $null = $utf8.GetString($data)
    } catch {
        Write-Host "[錯誤] build.bat 不是有效的 UTF-8"
        exit 1
    }

    if ($data.Length -ge 3 -and
        $data[0] -eq 239 -and
        $data[1] -eq 187 -and
        $data[2] -eq 191) {
        Write-Host "[錯誤] build.bat 含有 UTF-8 BOM"
        exit 1
    }

    for ($i = 0; $i -lt $data.Length; $i++) {
        if ($data[$i] -eq 10) {
            if ($i -eq 0 -or $data[$i - 1] -ne 13) {
                Write-Host "[錯誤] build.bat 含有 LF 換行，必須使用 CRLF"
                exit 1
            }
        }

        if ($data[$i] -eq 13) {
            if ($i + 1 -ge $data.Length -or $data[$i + 1] -ne 10) {
                Write-Host "[錯誤] build.bat 含有單獨 CR 換行"
                exit 1
            }
        }
    }

    Write-Host "✓ build.bat：UTF-8 無 BOM + CRLF"
'; then
    rm -f "$BAT_TEMP"
    echo "PUSH 已中止，請確認 build.bat 的格式。"
    exit 1
fi

rm -f "$BAT_TEMP"

ACTION_RUNTIME="src/user/action.ahk"
ACTION_TEMPLATE="src/user/action.ahk.template"
SETTING_RUNTIME="src/user/setting.ini"
SETTING_TEMPLATE="src/user/setting.ini.template"
SETTING_DEFAULT="src/reset/default_setting.ini"

# Runtime 存在時，先轉回 Template 狀態
if [ -f "$ACTION_RUNTIME" ]; then
    mv -f "$ACTION_RUNTIME" "$ACTION_TEMPLATE"
    echo "✓ action.ahk → action.ahk.template"
fi

if [ -f "$SETTING_RUNTIME" ]; then
    mv -f "$SETTING_RUNTIME" "$SETTING_TEMPLATE"
    echo "✓ setting.ini → setting.ini.template"

fi

# awk 只能安全處理單位元組文字；清理前先將 UTF-16 LE 轉成 UTF-8
# 先寫入暫存檔，轉換成功才覆蓋，避免轉碼失敗破壞原始資料
if [ -f "$SETTING_TEMPLATE" ]; then
    SETTING_BOM=$(od -An -tx1 -N2 "$SETTING_TEMPLATE" | tr -d ' \n')

    if [ "$SETTING_BOM" = "fffe" ]; then
        if ! iconv -f UTF-16 -t UTF-8 "$SETTING_TEMPLATE" > "$SETTING_TEMPLATE.encoding.tmp"; then
            rm -f "$SETTING_TEMPLATE.encoding.tmp"
            echo "[錯誤] setting.ini.template UTF-16 LE 轉碼失敗，已中止 Push。"
            exit 1
        fi
        mv -f "$SETTING_TEMPLATE.encoding.tmp" "$SETTING_TEMPLATE"
        echo "✓ setting.ini.template：UTF-16 LE → UTF-8"
    fi

    # 其他編碼若不是有效 UTF-8，直接中止，避免 awk 產生亂碼
    if ! iconv -f UTF-8 -t UTF-8 "$SETTING_TEMPLATE" > /dev/null 2>&1; then
        echo "[錯誤] setting.ini.template 不是有效的 UTF-8，已中止 Push。"
        exit 1
    fi
fi

# 清理 Template: 移除使用者 Hotkey Section，清空其餘 Runtime Value
# 即使前次 Push 已轉成 Template，仍需執行清理
if [ -f "$SETTING_TEMPLATE" ]; then
    awk '
    BEGIN {
        keep_value = 0
        skip_hotkey = 0
    }

    /^\[Hotkey\]$/ {
        skip_hotkey = 1
        next
    }
    /^\[/ {
        skip_hotkey = 0
        keep_value = ($0 == "[default-hotkey]")
        print
        next
    }

    skip_hotkey {
        next
    }

    {
        if (!keep_value && $0 ~ /^[^;#][^=]*=/) {
            sub(/=.*/, "=")
        }
        print
    }
    ' "$SETTING_TEMPLATE" > "$SETTING_TEMPLATE.tmp"

    mv -f "$SETTING_TEMPLATE.tmp" "$SETTING_TEMPLATE"
    echo "✓ 已清理 setting.ini.template 的 Runtime 值與 [Hotkey]"
fi

# Template 必須存在，Runtime 必須不存在
if [ ! -f "$ACTION_TEMPLATE" ] || [ ! -f "$SETTING_TEMPLATE" ]; then
    echo ""
    echo "[錯誤] Template 檔案不完整，已中止 Push。"
    exit 1
fi

if [ -f "$ACTION_RUNTIME" ] || [ -f "$SETTING_RUNTIME" ]; then
    echo ""
    echo "[錯誤] Runtime 檔案仍存在，已中止 Push。"
    exit 1
fi

# 比較 setting template 與 default 的 Section / Key
extract_ini_structure() {
    awk '
    /^[[:space:]]*\[/ {
        section = $0
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", section)
        print section
        next
    }

    /^[[:space:]]*[;#]/ {
        next
    }

    /=/ {
        key = $0
        sub(/=.*/, "", key)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)

        if (key != "") {
            print section "|" key
        }
    }
    ' "$1"
}

TEMPLATE_STRUCTURE="$(mktemp)"
DEFAULT_STRUCTURE="$(mktemp)"

extract_ini_structure "$SETTING_TEMPLATE" > "$TEMPLATE_STRUCTURE"
extract_ini_structure "$SETTING_DEFAULT" > "$DEFAULT_STRUCTURE"

STRUCTURE_DIFF="$(diff -u "$TEMPLATE_STRUCTURE" "$DEFAULT_STRUCTURE")"
DIFF_RESULT=$?

rm -f "$TEMPLATE_STRUCTURE" "$DEFAULT_STRUCTURE"

if [ "$DIFF_RESULT" -ne 0 ]; then
    echo ""
    echo "[錯誤] setting.ini.template 與 default_setting.ini 的 Section / Key 不一致。"
    echo ""
    echo "$STRUCTURE_DIFF"
    echo ""
    echo "請手動更新 src/reset/default_setting.ini 後，再次執行 git push。"
    echo "PUSH 已中止。"
    exit 1
fi

echo "✓ Template / Default 的 Section / Key 一致"
# 只處理 pre-push 相關檔案，不使用 git add -A
git add "$ACTION_TEMPLATE" "$SETTING_TEMPLATE" "$SETTING_DEFAULT"

# 有 staged 變更才建立轉換 commit
if ! git diff --cached --quiet -- "$ACTION_TEMPLATE" "$SETTING_TEMPLATE" "$SETTING_DEFAULT"; then
    git commit -m "chore: convert templates"

    echo ""
    echo "================================="
    echo "✓ Template 轉換完成"
    echo "✓ 已建立 commit：chore: convert templates"
    echo ""
    echo "請再次執行：git push"
    echo "================================="
    echo ""

    exit 1
fi

echo "✓ 專案已是乾淨的 Template 狀態"
echo "========== 開始 PUSH =========="
echo ""

exit 0
